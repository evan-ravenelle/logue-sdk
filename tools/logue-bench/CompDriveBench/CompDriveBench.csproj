<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NodeEditorAvalonia" Version="11.3.11" />
  </ItemGroup>

  <!-- The native harness carries the unit's real DSP; build it first and
       stage the dylib beside the app so DllImport can resolve it. -->
  <Target Name="BuildNativeHarness" BeforeTargets="Build">
    <Exec Command="make -C $(MSBuildProjectDirectory)/../host" />
  </Target>

  <ItemGroup>
    <None Include="../host/build/libcdhost.dylib" Condition="Exists('../host/build/libcdhost.dylib')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
